add_executable(kalandra-lsp lsp/main.cpp lsp/Edits.cpp)
target_include_directories(kalandra-lsp SYSTEM PRIVATE ${LLVM_INCLUDE_DIRS})
target_link_libraries(kalandra-lsp PRIVATE kalandra-semantics kalandra-project LLVM)
target_compile_options(kalandra-lsp PRIVATE -Wall -Wextra -Werror)
if(BUILD_TESTING)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  add_executable(kalandra-lsp-sanitized lsp/main.cpp lsp/Edits.cpp)
  target_include_directories(kalandra-lsp-sanitized SYSTEM PRIVATE ${LLVM_INCLUDE_DIRS})
  target_link_libraries(kalandra-lsp-sanitized PRIVATE kalandra-semantics-sanitized kalandra-project-sanitized LLVM)
  target_compile_options(kalandra-lsp-sanitized PRIVATE -Wall -Wextra -Werror -O1 -g
    -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  target_link_options(kalandra-lsp-sanitized PRIVATE -fsanitize=address,undefined)
  foreach(VARIANT IN ITEMS debug sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(SERVER kalandra-lsp-sanitized)
    else()
      set(SERVER kalandra-lsp)
    endif()
    add_test(NAME native-lsp-${VARIANT} COMMAND "${Python3_EXECUTABLE}"
      "${CMAKE_CURRENT_SOURCE_DIR}/lsp/ProtocolTests.py" "$<TARGET_FILE:${SERVER}>"
      "${CMAKE_CURRENT_BINARY_DIR}/lsp-${VARIANT}")
    set_tests_properties(native-lsp-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
endif()
if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-lsp-edits-${VARIANT} lsp/EditsTests.cpp lsp/Edits.cpp)
    target_include_directories(kalandra-lsp-edits-${VARIANT} PRIVATE include)
    target_compile_options(kalandra-lsp-edits-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_compile_options(kalandra-lsp-edits-${VARIANT} PRIVATE -O1 -g
        -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-lsp-edits-${VARIANT} PRIVATE -fsanitize=address,undefined)
    endif()
    add_test(NAME native-lsp-edits-${VARIANT} COMMAND kalandra-lsp-edits-${VARIANT})
    set_tests_properties(native-lsp-edits-${VARIANT} PROPERTIES TIMEOUT 30)
  endforeach()
endif()
