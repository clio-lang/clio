file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
endif()
function(COMPILE NAME SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.kalandra" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.kalandra" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Compile ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
endfunction()
function(VERIFY NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "Run ${NAME}/${WORKERS}: ${STATUS}: ${OUT}${ERR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
foreach(CASE IN ITEMS "scalars|-4" "mixed|16777218" "owned|16")
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 EXPECTED)
  file(READ "${FIXTURES}/task-int32-${NAME}.kalandra" SOURCE)
  COMPILE("${NAME}" "${SOURCE}")
  VERIFY("${NAME}" "${EXPECTED}")
endforeach()
file(READ "${FIXTURES}/task-int32-mixed.kalandra" SOURCE)
string(REPLACE "fn main() -> int32" "fn main() -> float32" SOURCE "${SOURCE}")
string(REGEX REPLACE "    value\n$" "    real\n" SOURCE "${SOURCE}")
COMPILE(mixed-float-root "${SOURCE}")
VERIFY(mixed-float-root 3)
file(READ "${OUTPUT_DIR}/mixed.ll" MIXED_IR)
if(NOT MIXED_IR MATCHES "result.scalar.int32" OR NOT MIXED_IR MATCHES "value.layout.scalar.int32" OR
   NOT MIXED_IR MATCHES "value.layout.scalar\"? =" OR NOT MIXED_IR MATCHES "task.frame")
  message(FATAL_ERROR "Mixed numeric frames/packets/layouts lost distinct integer/float identity")
endif()
# Two numeric parameter families of equal width must retain distinct result layouts.
foreach(OP IN ITEMS add sub mul div rem neg)
  if(OP STREQUAL "add")
    set(EXPR "a + b")
    set(CASES "2147483647,1" "-2147483648,-1")
  elseif(OP STREQUAL "sub")
    set(EXPR "a - b")
    set(CASES "-2147483648,1" "2147483647,-1")
  elseif(OP STREQUAL "mul")
    set(EXPR "a * b")
    set(CASES "-2147483648,-1" "2147483647,2")
  elseif(OP STREQUAL "div")
    set(EXPR "a / b")
    set(CASES "1,0" "-2147483648,-1")
  elseif(OP STREQUAL "rem")
    set(EXPR "a % b")
    set(CASES "1,0")
  else()
    set(EXPR "-a")
    set(CASES "-2147483648,1")
  endif()
  set(PREFIX "fn operation(a:int32,b:int32) -> int32:\n  ${EXPR}\nfn identity(value:int32) -> int32:\n  value\nfn run(a:int32,b:int32) -> int32 ! TaskError:\n  try parallel:\n    sibling = spawn identity(b)\n    job = spawn operation(a,b)\n    value = try await job\n    try await sibling\n    value\n")
  set(HANDLER "fn classify(a:int32,b:int32) -> int32:\n  outcome = run(a,b)\n  outcome catch fn(error):\n    match error:\n      TaskError.Fault {kind:cause,message:detail}:\n        match cause:\n          FaultKind.Arithmetic: 1\n          _: 0\n      _: 0\n")
  set(SUM "")
  foreach(INPUT IN LISTS CASES)
    if(NOT SUM STREQUAL "")
      string(APPEND SUM " + ")
    endif()
    string(APPEND SUM "classify(${INPUT})")
  endforeach()
  list(LENGTH CASES COUNT)
  COMPILE("${OP}-recovered" "${PREFIX}${HANDLER}fn main() -> int32:\n  ${SUM}\n")
  VERIFY("${OP}-recovered" "${COUNT}")
  list(GET CASES 0 INPUT)
  COMPILE("${OP}-fault" "${PREFIX}fn main() -> int32 ! TaskError:\n  try run(${INPUT})\n")
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${OP}-fault"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR
       NOT ERR MATCHES "TaskError.Fault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
      message(FATAL_ERROR "Integer task ${OP} fault/source/cleanup: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
  file(READ "${OUTPUT_DIR}/${OP}-recovered.mlir" MLIR)
  if(NOT MLIR MATCHES "arith.extsi" OR NOT MLIR MATCHES "kalandra_fault")
    message(FATAL_ERROR "Integer task arithmetic bypassed checked MLIR lowering")
  endif()
endforeach()
# The failed child's sibling may be cancelled or complete first; both must settle.
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    KALANDRA_TEST_FAIL_ALLOC_AT=1 KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/owned"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "AllocationFault" OR
     NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Root allocation failure did not settle mixed typed tasks: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
# An arithmetic fault in the coordinating task also ends that task, after await.
COMPILE(controller-fault "fn identity(x:int32) -> int32:\n  x\nfn main() -> int32 ! TaskError:\n  try parallel:\n    work = spawn identity(2147483647)\n    value = try await work\n    value + 1\n")
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/controller-fault"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "ArithmeticFault at source 7:5" OR
     NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Coordinating arithmetic fault did not settle: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "Int32 CPU task captures/results, mixed numeric frames, cached awaits, nested workers, checked MLIR faults and recovery passed with 1/2/4 workers")
foreach(INVALID IN ITEMS 0 65 invalid)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${INVALID}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/scalars"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR
     NOT ERR MATCHES "TaskError.AdmissionRejected" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Integer root lost admission error: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
