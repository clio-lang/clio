file(READ "${SOURCE_DIR}/placed.kalandra" VALID)
file(READ "${SOURCE_DIR}/composed.kalandra" COMPOSED)
file(MAKE_DIRECTORY "${OUTPUT_DIR}/source-checks")
set(ROOT "${OUTPUT_DIR}/source-checks")
function(reject_case NAME CONTENT)
  set(DEST "${ROOT}/${NAME}-out")
  file(MAKE_DIRECTORY "${DEST}")
  file(WRITE "${DEST}/host.cpp" "existing output sentinel")
  file(WRITE "${ROOT}/${NAME}.kalandra" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" "${ROOT}/${NAME}.kalandra" -o "${DEST}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(G001|S0|P0)")
    message(FATAL_ERROR "${NAME}: missing diagnostic: ${STATUS} ${ERROR}")
  endif()
  file(READ "${DEST}/host.cpp" SENTINEL)
  if(NOT SENTINEL STREQUAL "existing output sentinel" OR EXISTS "${DEST}/kernel0.mlir")
    message(FATAL_ERROR "${NAME}: invalid compilation changed output")
  endif()
endfunction()
string(REPLACE "product + left" "product / left" BAD "${VALID}")
reject_case(division "${BAD}")
string(REPLACE "product + left" "matmul(product, left)" BAD "${VALID}")
reject_case(matmul "${BAD}")
string(REPLACE "combine(deviceLeft, deviceRight)" "combine(left, deviceRight)" BAD "${VALID}")
reject_case(hidden-upload "${BAD}")
string(REPLACE "try await transfer(result, devices.cpu())" "result" BAD "${VALID}")
reject_case(hidden-download "${BAD}")
string(REPLACE "right: Tensor[float32, 3] = tensor([4, 5, 6])" "right: Tensor[float32, 2] = tensor([4, 5])" BAD "${VALID}")
reject_case(shape "${BAD}")
string(REPLACE "deviceRight = try await rightCopy" "deviceRight = deviceLeft" BAD "${VALID}")
reject_case(unobserved-child "${BAD}")
string(REPLACE "try await transfer(result, devices.cpu())" "work" BAD "${VALID}")
reject_case(task-escape "${BAD}")
string(REPLACE "devices.gpu()" "devices.gpu(-1)" BAD "${VALID}")
reject_case(negative-index "${BAD}")
string(REPLACE "devices.gpu()" "devices.gpu(1.5)" BAD "${VALID}")
reject_case(fractional-index "${BAD}")
string(REPLACE "devices.gpu()" "devices.gpu(4294967296)" BAD "${VALID}")
reject_case(index-overflow "${BAD}")
string(REPLACE "product + left" "product - left" BAD "${VALID}")
reject_case(subtraction "${BAD}")
string(REPLACE "product + left" "left" BAD "${VALID}")
reject_case(unused-entry-input "${BAD}")
string(REPLACE "add(left, square)" "add(left, 2)" BAD "${COMPOSED}")
reject_case(scalar-in-tensor-parameter "${BAD}")
string(REPLACE "product + left" "2" BAD "${VALID}")
reject_case(scalar-result "${BAD}")
string(REPLACE "float32" "float64" BAD "${VALID}")
reject_case(float64 "${BAD}")
string(REPLACE "gpu = devices.gpu()" "devices = devices.gpu()\n    gpu = devices.gpu()" BAD "${VALID}")
reject_case(shadowed-devices "${BAD}")
string(REPLACE "work = spawn" "work = await" BAD "${VALID}")
reject_case(malformed-placement "${BAD}")
string(REPLACE "product = left * right" "product = left * right\n  product = left + right" BAD "${VALID}")
reject_case(rebinding "${BAD}")
# A scalar CPU program establishes that ordinary native lowering never discards placement.
file(WRITE "${ROOT}/cpu.kalandra" "fn identity(x: float32) -> float32:\n  x\nfn main() -> float32 ! TaskError:\n  try parallel:\n    try await spawn identity(1) on devices.gpu()\n")
execute_process(COMMAND "${CPU_CHECKER}" "${ROOT}/cpu.kalandra" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "S045")
  message(FATAL_ERROR "CPU checker ignored placed call: ${ERROR}")
endif()
# Recompilation is deterministic; target aliases and repeated placed calls are accepted.
string(REPLACE "    left: Tensor" "    destination = gpu\n    left: Tensor" GOOD "${VALID}")
string(REPLACE " on gpu" " on destination" GOOD "${GOOD}")
string(REPLACE "result = try await work" "result = try await work\n    repeated = try await spawn combine(result, deviceLeft) on destination" GOOD "${GOOD}")
file(WRITE "${ROOT}/valid.kalandra" "${GOOD}")
execute_process(COMMAND "${COMPILER}" "${ROOT}/valid.kalandra" -o "${ROOT}/valid-out" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Valid alias/repeated placement rejected: ${ERROR}")
endif()
file(SHA256 "${ROOT}/valid-out/host.cpp" BEFORE)
execute_process(COMMAND "${COMPILER}" "${ROOT}/valid.kalandra" -o "${ROOT}/valid-out" RESULT_VARIABLE STATUS)
file(SHA256 "${ROOT}/valid-out/host.cpp" AFTER)
if(NOT STATUS EQUAL 0 OR NOT BEFORE STREQUAL AFTER)
  message(FATAL_ERROR "Compilation is not deterministic")
endif()
message(STATUS "Metal source diagnostics, immutable outputs, aliases, repeated calls, and CPU rejection passed")

