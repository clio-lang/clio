file(READ "${OUTPUT_DIR}/strict.lowered.mlir" LOWERED)
file(READ "${OUTPUT_DIR}/strict.spvasm" SPIRV)
file(READ "${OUTPUT_DIR}/strict.metal" MSL)
file(READ "${OUTPUT_DIR}/strict-cpu.ll" LLVM)
if(LOWERED MATCHES "arith\\.(addf|mulf|divf)" OR SPIRV MATCHES "OpF(Add|Mul|Div)|Fma|FPFastMathMode" OR MSL MATCHES "fma[ \t]*\\(" OR LLVM MATCHES "(fadd|fmul|fdiv|llvm.fma)")
  message(FATAL_ERROR "Strict integer arithmetic retained or introduced a floating operation")
endif()
if(NOT SPIRV MATCHES "OpCapability Int64" OR NOT SPIRV MATCHES "OpIMul" OR NOT SPIRV MATCHES "OpIAdd")
  message(FATAL_ERROR "Expected 64-bit integer arithmetic missing")
endif()
file(READ "${OUTPUT_DIR}/strict.reflection.json" REFLECTION)
string(JSON ENTRY GET "${REFLECTION}" entryPoints 0 name)
string(JSON WIDTH GET "${REFLECTION}" entryPoints 0 workgroup_size 0)
string(JSON BUFFERS LENGTH "${REFLECTION}" ssbos)
if(NOT ENTRY STREQUAL "strict_binary32" OR NOT WIDTH EQUAL 64 OR NOT BUFFERS EQUAL 4)
  message(FATAL_ERROR "Unexpected strict kernel interface")
endif()
foreach(INDEX RANGE 0 3)
  string(JSON BINDING GET "${REFLECTION}" ssbos ${INDEX} binding)
  string(JSON SIZE GET "${REFLECTION}" ssbos ${INDEX} block_size)
  if(INDEX EQUAL 3)
    set(EXPECTED_SIZE 8)
  else()
    set(EXPECTED_SIZE 16384)
  endif()
  if(NOT BINDING EQUAL INDEX OR NOT SIZE EQUAL EXPECTED_SIZE)
    message(FATAL_ERROR "Strict kernel buffer mapping changed")
  endif()
endforeach()
message(STATUS "Strict CPU/GPU arithmetic contains only integer operations and the expected buffer interface")
