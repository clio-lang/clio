{
  "milestone": "Completed error aliases in CPU record/enum/error payload fields",
  "date": "2026-10-19",
  "baseline_commit": "69df5b78b49a672092a3cd17602fac74ab7be29f",
  "host": "Apple M2 Max / macOS arm64",
  "implementation": {
    "resolution": "Resolve source field dependencies lazily before copying canonical union payloads. Preserve original nominal IDs, exported bindings and alias sets independent of declaration order. Reject cycles and excessive dependency depth.",
    "values": "Single-family aliases, application unions and mixed TaskError aliases are completed ordinary field data. Supported record arrays and nested wrapper errors retain their original payloads. Field values require exact canonical types; result channels keep their existing subset rules.",
    "task_error": "TaskError is accepted directly in ordinary annotations or through an alias. Fields use bounded existing Failure data and validate the four possible kinds while preserving code/line/column.",
    "validation": "Generated record copies validate even without owned backing. Inactive enum variants are skipped. Canonical private TaskError identity cannot be forged as an ordinary source family.",
    "ownership": "Existing immutable retention handles active nested fields, worker captures/results, cached awaits and source/scheduler teardown. Failed private copies leave output unchanged.",
    "limits": [
      "CPU only; no GPU error transport, distributed contracts or public C/C++ interface added.",
      "Recursive record/enum storage and alias cycles remain rejected.",
      "TaskError arrays remain unsupported; arrays of supported tagged error records are supported.",
      "Whole-value narrowing in match arms remains follow-up work."
    ]
  },
