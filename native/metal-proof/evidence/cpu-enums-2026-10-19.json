    "coverage": [
      "All ten numeric widths at signed/unsigned/float endpoints, plus Bool and String payloads",
      "Common field spellings with different per-variant types; no implicit common-field access",
      "Named construction/field typing, non-exhaustive/duplicate/unreachable branches, nominal identity and invalid typed layouts",
      "Renamed/omitted fields, branch-local bindings, one-variant and fallback-only matches",
      "Only selected branches execute; unused payloads still evaluate and fault at original source locations",
      "UTF-8 String payloads created by children survive child settlement and repeated awaits",
      "Enum values in immutable records and arrays, array maps and worker handoff",
      "Module imports, aliases and re-exports preserve enum identity",
      "Nested/cached workers and runtime allocation positions 1..24 with one/two/four workers; zero-live cleanup on faults",
      "Diagnostics preserve existing executable/IR output; unsupported Metal rejected",
      "Full frontend and focused record, array, String ownership, control-flow, recovery, module and type-export regressions"
    ],
    "documentation_example": {
      "file": "docs/design/native-enums.md",
      "compiled_optimized": true,
      "stdout": "21\n"
    },
    "development_corrections": [
      "Enum conditionals retain explicit final-branch statements, including single-arm bindings and subject evaluation",
      "Discriminator validation permits dynamic reconstruction by the existing continuation planner while rejecting invalid literal constructors",
      "Nested enum match lowering is bounded by the configured branch-depth budget"
    ]
