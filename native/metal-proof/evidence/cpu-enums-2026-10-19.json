  "implementation": {
    "frontend": "Contextual enum declarations, qualified constructors, nominal module identities, named fields, exhaustive matching and branch-local bindings",
    "storage": "Private fully initialized tagged aggregates reuse record storage; inactive scalar/Bool/String fields have inert defaults. No public ordinal or layout ABI.",
    "lowering": "Existing aggregate and conditional IR reused, including single-arm scopes, subject evaluation and configured lowering-depth budgets",
    "workers": "Existing record capture/result and String ownership paths reused for current enum subset, including enum values in records and arrays",
    "limits": "Collection, record and nested-enum payload fields, recursive payloads, GPU enums and application error declarations remain gated; compact storage and switch dispatch tracked separately"
  },
