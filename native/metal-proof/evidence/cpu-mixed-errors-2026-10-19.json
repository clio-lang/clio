{
  "milestone": "Local error channels combining application families and built-in TaskError",
  "date": "2026-10-19",
  "baseline_commit": "0119f8ebcf4627fb71bcba5c80def140577ac225",
  "host": "Apple M2 Max / macOS arm64",
  "implementation": {
    "typing": "TaskError participates in canonical error-family sets, aliases, subset propagation, joins and handler replacement. TaskError-only aliases normalize to the existing built-in channel.",
    "representation": "Private canonical task family carries bounded original Failure metadata in each tagged variant. Legacy expected-error prefixes normalize into mixed members, preserving kind/code/line/column.",
    "fields": "TaskError.Fault exposes FaultKind and materialized String diagnostics; AdmissionRejected exposes its existing String reason. Fields remain available only in their selected variants.",
    "ownership": "Only active payloads are interpreted and retained. Task-only outcomes do not retain inactive application strings/arrays. Expected failure prefixes bypass absent TaskError success-value validation.",
    "abi": "Existing scheduler Failure and task-failure classifications unchanged. Private typed TaskError aggregate calls and task handles use their correct native layouts.",
    "limits": [
      "Application-fallible spawn results and application errors escaping parallel bodies remain gated.",
      "Whole-value match-arm narrowing and error aliases in record/enum payload declarations remain follow-up work.",
      "No distributed execution, GPU error transport, public C/C++ ABI or sibling cancellation policy change."
    ]
  },
