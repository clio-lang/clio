{
  "milestone": "Application-error results through local CPU workers and parallel-group settlement",
  "date": "2026-10-19",
  "baseline_commit": "1aed481281bb88efadba8af26693c03b1d37cfb7",
  "host": "Apple M2 Max / macOS arm64",
  "implementation": {
    "typing": "Spawn retains the declared application channel. Await widens it to include TaskError. Parallel groups collect propagated families alongside their execution channel; signatures must cover all families.",
    "observation": "Read against the child result layout, then widen the selected error variant when layouts differ. Equal layouts keep the existing direct read path. Cached observations never rerun a child.",
    "settlement": "Application payload stays in the typed owner frame across suspension. Private locked stopGroup reserves the primary outcome and uses an internal cancellation marker only to drain descendants; generated join preserves the original typed error.",
    "precedence": "An already recorded task failure wins over a later application propagation. Once the application outcome is reserved, sibling-drain cancellation cannot replace it. Concurrent failure order is not promised.",
    "recovery": "A caught application outcome does not fail the group. A checked child execution fault remains sticky at the group boundary.",
    "limits": [
      "Local CPU execution only; GPU error transport, distributed execution and public C/C++ integration are separate work.",
      "No secondary diagnostic aggregation added.",
      "Error aliases in payload declarations and whole-value match-arm narrowing remain tracked refinements."
    ]
  },
