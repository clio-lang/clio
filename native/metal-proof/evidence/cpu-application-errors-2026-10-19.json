{
  "milestone": "Local single-family application-error channels and early failure guards",
  "date": "2026-10-19",
  "baseline_commit": "e8acf91a61ebb94da1055631f2d3e4fb77d7d3e5",
  "host": "Apple M2 Max / macOS arm64",
  "implementation": {
    "typing": "Declared nominal error families; single-family T ! E channels, fail/try/catch, strict propagation, handler replacement and direct-final-fail guards.",
    "ownership": "Private typed error arm retains active payload backing independently of absent success values; original execution-failure prefix retained.",
    "boundaries": "Errors can be ordinary worker values or handled locally within workers. Escaping application channels through spawn/await and parallel groups remain rejected pending E | TaskError.",
    "cli": "Unhandled application errors preserve Family.Variant, exit 89 and settle managed owners; execution faults bypass application recovery.",
    "limits": "Error-family unions and aliases remain follow-up work. No public C/C++ ABI, network contracts, distributed execution or GPU error transport is introduced."
  },
