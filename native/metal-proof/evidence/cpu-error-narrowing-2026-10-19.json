{
  "milestone": "Lexical error-family narrowing in selected and residual CPU match branches",
  "date": "2026-10-19",
  "baseline_commit": "899bc51fb7da8c69a715aff07d72869a11c95006",
  "host": "Apple M2 Max / macOS arm64",
  "implementation": {
    "scope": "A matched named completed error-union binding receives the selected original family within an explicit branch. Wildcards retain every family with unmatched variants. Other bindings, snapshots and the surrounding scope keep their existing types.",
    "identity": "Generated branch bindings preserve the original declaration location and nominal family identity. No new individual-variant types or implicit ordinary-value widening are introduced.",
    "representation": "Checked ErrorNarrow projection remaps original family/variant identities into a strict subset. Pure MLIR lowering is shared with continuation kernels and synchronous map callbacks/captures.",
    "ownership": "Only selected payload fields are copied, sharing their existing immutable backing. Underlying arrays/strings are not copied by projection; later existing field operations retain their own semantics.",
    "task_error": "TaskError subsets project into the existing bounded Failure value without changing kind/code/line/column. Synchronous validation now checks that canonical task carrier tags agree with the selected Failure kind, matching worker-copy validation.",
    "safety": "Invalid destination family sets, non-preceding/self inputs and malformed result types are rejected by typed-IR validation. Runtime projection guards reject tags outside the target. Inactive payloads remain ignored.",
    "limits": [
      "CPU only; GPU error transport, distributed execution and public C/C++ integration remain separate.",
      "Narrowing tracks named lexical bindings and family sets, not arbitrary field paths, snapshot aliases or new individual-variant types.",
      "Ordinary value fields/parameters still require exact canonical error-value types. Expected-error channels keep subset widening."
    ]
  },
