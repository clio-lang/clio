@params Number Number
@returns Number
@check
@describe "sum"
export fn sum n total:
  if n > 0: sum (n - 1) (total + n)
  else: total

export fn make decorate:
  @decorate
  fn count n total:
    if n > 0: count (n - 1) (total + n)
    else: total
  count

@describe "async sum"
export fn asyncSum n total pause:
  if n > 0: asyncSum (n - 1) (total + n) pause
  else: await pause total
