from "remote:./math.client.json" import calculate as twice broken slow
import "remote:./math.client.json" as math

export fn main:
  [(await twice 1.5) (2.5 -> await math.calculate) (await |twice| 3.5)]

export fn failure: await broken 1
export fn deadline: await slow 45

from "remote:./math.client.json" import Point NamedPoint Other Box echoPoint echoNamed echoBox choosePoint
export Point
export NamedPoint
export Other
export Box

export fn records:
  point = await echoPoint (Point 1.5 2.5)
  named = await echoNamed (NamedPoint "named" 3.5 4.5)
  box = await echoBox (Box [(Point 5.5 6.5) point])
  left = await choosePoint 1
  right = await choosePoint 0
  [point named box left right]

@params Point
export fn recordInput point: await echoPoint point

from "remote:./math.client.json" import capturedCalculate capturedRecord capturedNaN
export fn captures:
  [(await capturedCalculate 1.5) (await capturedCalculate 1.5)]
export fn capturedRecords: await capturedRecord 2
export fn capturedNumber: await capturedNaN 1

@params Number
fn localRemote n: await math.calculate n
export fn fromWorker: await |localRemote| 1.5

@params Number
fn localSlow n: await slow n
export fn workerDeadline: await |localSlow| 45

@params NamedPoint
@returns NamedPoint
fn typedRemote value: await echoNamed value
export fn recordsFromWorker: await |typedRemote| (NamedPoint "worker" 1.5 2.5)

@params Box
@returns Box
fn typedBox value: await echoBox value
export fn boxesFromWorker: await |typedBox| (Box [(Point 3.5 4.5)])

export type MeasuredPoint is math.NamedPoint:
  Number weight

@params MeasuredPoint
@returns MeasuredPoint
fn measuredRemote value:
  echoed = await echoNamed (NamedPoint value.name value.z value.x)
  MeasuredPoint value.weight echoed.name echoed.z echoed.x

export fn subclassFromWorker:
  await |measuredRemote| (MeasuredPoint 7 "measured" 1.5 2.5)


from "remote:./math.client.json" import mapPoint

export fn mappedRecords:
  [(Point 1.5 2.5) (Point 3.5 4.5)] -> * [await] mapPoint

@params Number
fn mappedCaptured n:
  [n (n + 1)] -> * [await] capturedCalculate

export fn mapsFromWorker: await |mappedCaptured| 1.5

export fn checkedMapFailure:
  [(Point 1.5 2.5)] -> * [await] echoPoint
