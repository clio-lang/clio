@params Number
@returns Number
export fn calculate n: n * 2 + 0.25

@params Number
@returns Number
export fn broken n:
  n.missing ()
  n

@params Number
@returns Number
export fn slow n:
  if n < 2: n
  else: (slow (n - 1)) + (slow (n - 2))

export type Point:
  Number z
  Number x

export type NamedPoint is Point:
  String name

export type Other:
  Number z
  Number x

list Points: Point
export type Box:
  Points points

@params Point
@returns Point
@check
export fn echoPoint point: point

@params NamedPoint
@returns NamedPoint
@check
export fn echoNamed point: point

@params Box
@returns Box
@check
export fn echoBox box: box

@params Number
export fn choosePoint n:
  if n > 0: Point n 2
  else: Other n 3

Box capturedState = Box [(Point 1.5 2.5)]
NamedPoint capturedName = NamedPoint "baseline" 3.5 4.5
Number capturedScale = 0 / 0

@params Number
fn readCapture n: n + capturedState.points[0].z

@params Number
export fn capturedCalculate n:
  capturedState.points[0].z = capturedState.points[0].z + 1
  await |readCapture| n

@params Number
export fn capturedRecord n:
  capturedName.z = capturedName.z + n
  capturedName

@params Number
export fn capturedNaN n: n + capturedScale

@params Point
@returns Point
export fn mapPoint point: point
