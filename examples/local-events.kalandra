type State:
  Number value

@params Number
@returns Number
fn process n:
  state = State 0
  events = emitter ()
  fn receive: state.value = state.value + n
  events.on "reading" receive
  events.emit "reading"
  events.emit "reading"
  events.off "reading" receive
  events.emit "reading"
  state.value

export fn main: [3 7] -> * [await] |process|
