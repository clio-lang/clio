from "./types" import TaggedReading

type Calibration:
  Number offset
Calibration settings = Calibration 1

@params TaggedReading
@returns TaggedReading
fn calibrate reading:
  settings.offset = settings.offset + 1
  TaggedReading reading.label (reading.value + settings.offset)

@params TaggedReading
@returns TaggedReading
export fn process reading: await |calibrate| reading
