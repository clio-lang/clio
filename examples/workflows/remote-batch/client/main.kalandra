from "remote:./readings.client.json" import TaggedReading calibrate

@params Number
fn batch start:
  readings = [(TaggedReading "north" start) (TaggedReading "south" (start + 10))]
  readings -> * [await] calibrate

export fn main:
  first = await |batch| 10
  second = await |batch| 10
  [first[0].value first[1].value second[0].value second[1].value]
