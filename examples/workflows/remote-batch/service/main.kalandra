export type Reading:
  Number value
export type TaggedReading is Reading:
  String label

type Calibration:
  Number offset
Calibration settings = Calibration 1

@params TaggedReading
@returns TaggedReading
export fn calibrate reading:
  settings.offset = settings.offset + 1
  TaggedReading reading.label (reading.value + settings.offset)

@params Number
@returns Number
export fn broken n:
  n.missing ()
  n

@params Number
@returns Number
export fn slow n:
  if n < 2: n
  else: (slow (n - 1)) + (slow (n - 2))
